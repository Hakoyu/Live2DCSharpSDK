<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTK" Version="4.9.4" />
    <PackageReference Include="OpenTK.GLWpfControl" Version="4.3.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Live2DCSharpSDK.OpenGL\Live2DCSharpSDK.OpenGL.csproj" />
    <!-- 宿主代码直接使用 App 的类型（LAppDelegate/LAppModel 等），因此显式声明本引用；
         宿主工程不打包，普通 ProjectReference 不会产生包依赖。 -->
    <ProjectReference Include="..\Live2DCSharpSDK.App\Live2DCSharpSDK.App.csproj" />
  </ItemGroup>

  <!--
    Live2DCubismCore.dll 的复制项由 Live2DCSharpSDK.Framework.csproj 统一提供
    （runtimes/win-x64/native 下的原生库以 Link=Live2DCubismCore.dll 复制到输出目录，
     并经 ProjectReference 传递到本工程输出目录）。
    C4 清理：此处原有重复的 None Update="Live2DCubismCore.dll" 项，已删除。
  -->
</Project>
